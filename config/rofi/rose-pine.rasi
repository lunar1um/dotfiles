configuration {
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    display-ssh: "SSH";
    show-icons: false;
    icon-theme: "Papirus";
    font: "0xProto Nerd Font Mono 12.5";
    modi: "drun";
    location: 6;
}

* {
    bg: #26233a;
    bg-alt: #21202e;
    bg-selected: #403d52;
    fg: #e0def4;
    fg-alt: #908caa;
    border: #524f67;
    urgent: #f7768e;
    active: #9ece6a;

    background-color: transparent;
    text-color: @fg;
}

window {
    background-color: #26233a;
    border: 2px;
    border-color: @border;
    border-radius: 10px;
    width: 500px;
    x-offset: 0;
    y-offset: -20px;

    scroll-method: 0;
}

prompt {
    enabled: false;
    padding: 10px 16px;
    background-color: #24283baa;
    text-color: @fg-alt;
    border-radius: 5px;
    margin: 0px 8px 0px 0px;
}

textbox-prompt-sep {
    expand: false;
    str: "";
}

entry {
    background-color: #1f1d2e;
    text-color: @fg;
    placeholder-color: @fg-alt;
    expand: true;
    horizontal-align: 0;
    placeholder: "start typing...";
    padding: 15px 20px;
    border-radius: 10px;
    blink: true;
}

inputbar {
    children: [ prompt, entry ];
    background-color: transparent;
    text-color: @fg;
    expand: false;
    border-radius: 10px;
    padding: 5px;
}

listview {
    background-color: transparent;
    columns: 2;
    lines: 4;
    layout: vertical;
    spacing: 2px;
    padding: 5px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 5px;
    padding: 10px;
}

element {
    text-color: @fg;
    orientation: horizontal;
    border-radius: 6px;
    padding: 15px;
}

element-icon {
    text-color: inherit;
    size: 32px;
    cursor: inherit;
    margin: 0px 8px 0px 0px;
}

element-text {
    text-color: inherit;
    expand: true;
    horizontal-align: 0;
    vertical-align: 0.5;
    cursor: inherit;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg-alt;
}

element selected.normal {
    background-color: #ebbcba30;
    text-color: @fg;
    border: 3px;
    border-color: #ebbcba;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg-alt;
}

message {
    background-color: #24283baa;
    margin: 20px 0px 0px 0px;
    border-radius: 6px;
    padding: 10px;
}

textbox {
    text-color: @fg;
    padding: 8px;
}

mode-switcher {
    enabled: false;
}

button {
    padding: 8px 16px;
    background-color: #24283baa;
    text-color: @fg-alt;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    border-radius: 6px;
}

button selected {
    background-color: @bg-selected;
    text-color: @fg;
}
